datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Score {
  id        Int      @id @default(autoincrement())
  name      String
  score     Int
  time      Int
  createdAt DateTime @default(now())

  @@index([score(sort: Desc), time(sort: Asc)])
}
